# Set default behavior to automatically normalize line endings
* text=auto

# PHP and web source files (LF normalized)
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary

